{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/work",
      "destination": "/work.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/work/",
      "destination": "/work.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    }
  ]
}